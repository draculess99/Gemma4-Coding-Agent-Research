# allow-list in reports/GEMMA4_GITHUB_PUBLICATION_REVIEW.md over `git add -A`.

# ---- Developer Agent competition work: separate from the Paper Track, NOT published in this repo ----
/agent/
/submission/
/experiments/
/reference/
/reports/

# ---- third-party clone (own .git, MIT licence) - users clone it themselves at the pinned commit ----
/paper/experiments/p1_harness/_scratch/

# ---- local-only research material, held back ----
/paper/research/source_archive/
/paper/media/cover/

# ---- superseded P1 navigation READMEs (they state "no results exist"; stale after P2B/P2C) ----
# The other P1 documents (feasibility, next steps, file manifest, outline) are published as dated historical
# records; the root README.md says so. Replace these READMEs with the root README and paper/REPRODUCING.md.
/paper/README.md
/paper/experiments/p1_harness/README.md
/paper/results/README.md
/paper/scripts/README.md

