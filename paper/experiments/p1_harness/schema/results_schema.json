{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One row of results.jsonl (one agent run = one task x one arm x one seed)",
  "type": "object",
  "required": ["run_id", "task_id", "arm", "seed", "end_reason", "submitted", "resolved_final_state", "resolved_submitted",
               "turns", "tool_calls", "test_runs", "prompt_tokens", "completion_tokens", "model_seconds", "wall_seconds",
               "is_mock", "harness_version", "config_sha256", "manifest_sha256", "timestamp_utc"],
  "properties": {
    "run_id": {"type": "string", "description": "sha1(task|arm|seed|config hash|manifest hash)[:16]; makes runs resumable and unique"},
    "task_id": {"type": "string"},
    "arm": {"type": "string", "enum": ["arm1_basic", "arm2_test_guided", "arm2b_agent_initiated_tests", "arm3_graph_test_validated", "arm3b_test_validated_nograph"]},
    "seed": {"type": "integer"},
    "end_reason": {"type": "string", "enum": ["submitted", "max_turns", "max_tool_calls", "wall_timeout", "format_abort", "backend_error"]},
    "submitted": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "resolved_final_state": {"type": "boolean", "description": "PRIMARY. Official QuixBugs pytest file passes on the final workspace file, whether or not the agent submitted."},
    "resolved_submitted": {"type": "boolean", "description": "SECONDARY. resolved_final_state AND the agent called submit."},
    "syntax_error_final": {"type": "boolean"},
    "final_tests": {"type": "object", "description": "grader output: tests / failed / status"},
    "ast_equal_reference": {"type": "boolean", "description": "Final AST equals the reference fix AST (after normalisation). Proxy for 'right for the right reason'. A resolved run with false here is a candidate test-adequate-but-different patch and is hand-audited."},
    "diff_lines_changed": {"type": "integer"},
    "patch": {"type": "string", "description": "unified diff original->final"},
    "initial_failed": {"type": ["integer", "null"], "description": "failing tests at start (arms with auto_test only)"},
    "turns": {"type": "integer"}, "tool_calls": {"type": "integer"}, "format_errors": {"type": "integer"},
    "unknown_tool_calls": {"type": "integer"}, "test_runs": {"type": "integer"}, "edits": {"type": "integer"},
    "edit_errors": {"type": "integer"}, "gate_rejections": {"type": "integer"}, "graph_calls": {"type": "integer"},
    "reads": {"type": "integer"}, "context_truncations": {"type": "integer"},
    "prompt_tokens": {"type": "integer"}, "completion_tokens": {"type": "integer"},
    "model_seconds": {"type": "number"}, "test_seconds": {"type": "number"}, "wall_seconds": {"type": "number"},
    "is_mock": {"type": "boolean", "description": "true => scripted self-test row; summarize.py refuses these"},
    "harness_version": {"type": "string"},
    "config_sha256": {"type": "string"}, "manifest_sha256": {"type": "string"},
    "sampling": {"type": "object"}, "budgets": {"type": "object"},
    "timestamp_utc": {"type": "string", "format": "date-time"}
  }
}
